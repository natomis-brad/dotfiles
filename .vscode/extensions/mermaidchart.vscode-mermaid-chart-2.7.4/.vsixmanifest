<?xml version="1.0" encoding="utf-8"?>
	<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
		<Metadata>
			<Identity Language="en-US" Id="vscode-mermaid-chart" Version="2.7.4" Publisher="MermaidChart" />
			<DisplayName>Mermaid</DisplayName>
			<Description xml:space="preserve">The official Mermaid Editor plugin by the Mermaid open source team, now with AI-powered diagramming! Create, edit and preview diagrams seamlessly within VS Code</Description>
			<Tags>mermaid charts,MermaidCharts,mermaid,diagram,mermaid chart,visio,flowchart,sequence diagram,gantt,pie chart,class diagram,state diagram,entity relationship diagram,user journey diagram,user journey,journey,pie,sequence,flow,flow chart,gantt chart,architecture,uml,theme,color-theme,keybindings,Mermaid,__ext_mmd,__ext_mermaid,mermaid.flowchart,Mermaid Flowchart,mermaid flowchart,mermaid.sequenceDiagram,Mermaid Sequence Diagram,mermaid sequence diagram,mermaid.erDiagram,Mermaid Er Diagram,mermaid er diagram,mermaid.c4Diagram,Mermaid C4 Diagram,mermaid c4 diagram,mermaid.classDiagram,Mermaid Class Diagram,mermaid class diagram,mermaid.gantt,Mermaid Gantt,mermaid gantt,mermaid.gitGraph,Mermaid GitGraph,mermaid gitgraph,mermaid.info,Mermaid Info,mermaid info,mermaid.journey,Mermaid Journey,mermaid journey,mermaid.pie,Mermaid Pie,mermaid pie,mermaid.requirementDiagram,Mermaid Requirement Diagram,mermaid requirement diagram,mermaid.stateDiagram,Mermaid State Diagram,mermaid state diagram,mermaid.quadrantChart,Mermaid quadrantChart,mermaid QuadrantChart,mermaid.mindmap,Mermaid mindmap,mermaid Mindmap,mermaid.timeline,Mermaid timeline,mermaid Timeline,mermaid.sankey,Mermaid sankey,mermaid SankeyDiagram,mermaid.xychart,Mermaid xychart,mermaid Xychart,mermaid.kanban,Mermaid kanban,mermaid Kanban,mermaid.block,Mermaid blockDiagram,mermaid BlockDiagram,mermaid.architecture,Mermaid architecture,mermaid Architecture,mermaid.packet,Mermaid packet,mermaid Packet,mermaid.zenuml,Mermaid zenuml,mermaid Zenuml,mermaid.radar,Mermaid Radar,mermaid radar</Tags>
			<Categories>Visualization</Categories>
			<GalleryFlags>Public</GalleryFlags>
			
			<Properties>
				<Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.77.0" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value="" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionKind" Value="workspace" />
